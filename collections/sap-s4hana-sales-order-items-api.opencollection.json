            "params": [
              {
                "name": "SalesOrder",
                "value": "",
                "type": "path",
                "description": "Sales order number (10-character string, e.g., '0000000001')"
              },
              {
                "name": "SalesOrderItem",
                "value": "",
                "type": "path",
                "description": "Sales order item number (6-character string, e.g., '000010')"
