            "url": "https://sandbox.api.sap.com/s4hanacloud/sap/opu/odata/sap/API_SALES_ORDER_SRV/A_SalesOrderItem(SalesOrder=':SalesOrder',SalesOrderItem=':SalesOrderItem')",
            "headers": [
              {
                "name": "If-Match",
                "value": ""
